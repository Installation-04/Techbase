# HTTPS in front of the app (used by docker-compose.https.yml).
# Caddy gets and renews a Let's Encrypt certificate for $DOMAIN automatically
# (for localhost it uses its own local CA, handy for trying this out).
{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:80
}
