DB_HOST=db
DB_PORT=5432
DB_NAME=techbase
DB_USER=techbase
DB_PASSWORD=changeme
JWT_SECRET=change_this_secret_in_production
NODE_ENV=production
# Comma-separated list of allowed frontend origins (e.g. your Netlify URL)
CORS_ORIGIN=http://localhost

# Optional SSO (Google / Microsoft 365). Leave unset to hide those login
# buttons entirely — local email/password + self-registration always works.
# See README "Connexion SSO" for how to obtain these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Restrict Microsoft login to one organization's tenant instead of any
# Microsoft account. Leave unset (defaults to "common") to allow both
# personal Microsoft accounts and any Microsoft 365 work/school account.
MICROSOFT_TENANT_ID=

# Only needed if the backend is reachable at a different origin than the
# frontend (e.g. the split-hosting deploy in the README) — used to build
# the OAuth callback and redirect-back URLs.
# PUBLIC_URL=https://your-backend.example.com
# FRONTEND_URL=https://your-frontend.example.com

# Optional email notifications (bon de service assignment, daily digest of
# overdue maintenance / low EPI stock). Leave unset to disable — everything
# still works, just without emails; in-app notifications always work.
# Get a key at https://resend.com — no other setup required.
RESEND_API_KEY=
EMAIL_FROM=TechBase <onboarding@resend.dev>

# Optional ERP integration (Acumatica). Leave unset to hide the
# "Intégrations" tab entirely. See README "Intégration ERP" for details.
ACUMATICA_BASE_URL=
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=
ACUMATICA_COMPANY=
ACUMATICA_BRANCH=
ACUMATICA_ENDPOINT_NAME=Default
ACUMATICA_ENDPOINT_VERSION=24.200.001
